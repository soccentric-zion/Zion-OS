# ─── Yocto build output ───────────────────────────────────────────────────────
build/
sstate-cache/
downloads/

# ─── KAS artefacts ────────────────────────────────────────────────────────────
.kas-cache/

# ─── Yocto / BitBake generated files ─────────────────────────────────────────
# Cloned upstream layers (managed by KAS, never edited by hand)
layers/

# BitBake lock and pseudo database
bitbake.lock
pseudodone

# SDK installers
deploy/**/*.sh

# Compiled Python
*.pyc
*.pyo
__pycache__/

# ─── Docker artefacts ─────────────────────────────────────────────────────────
*.tar
*.tar.gz

# ─── SD card images (large) ───────────────────────────────────────────────────
*.wic
*.wic.bz2
*.wic.bmap
*.img
*.img.bz2

# ─── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log

deploy/

# meta/ holds the meta-zion Yocto layer, now fetched by kas from its own
# upstream (soccentric-zion/meta-zion) and checked out here as a nested
# clone — never tracked in this repo.
meta/*

# Host SSH keys used to fetch the private HAL repo during eSDK Docker build
docker/esdk/ssh/

sstate/

# SDK installers staged into Docker build contexts by sdk-image/esdk-image
docker/sdk/sdk.sh
docker/esdk/esdk.sh
