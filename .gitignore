# ─── Yocto build output ───────────────────────────────────────────────────────
build/
sstate-cache/
downloads/

# ─── KAS artefacts ────────────────────────────────────────────────────────────
.kas-cache/

# ─── Yocto / BitBake generated files ─────────────────────────────────────────
# Cloned upstream layers (managed by KAS, never edited by hand)
layers/

# BitBake lock and pseudo database
bitbake.lock
pseudodone

# SDK installers
deploy/**/*.sh

# Compiled Python
*.pyc
*.pyo
__pycache__/

# ─── Docker artefacts ─────────────────────────────────────────────────────────
*.tar
*.tar.gz

# ─── SD card images (large) ───────────────────────────────────────────────────
*.wic
*.wic.bz2
*.wic.bmap
*.img
*.img.bz2

# ─── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log

deploy/

# meta/ holds the meta-zion Yocto layer, which historically was
# committed to this repo before the layer-fetch was wired through
# kas/repos/. Re-enable tracking here so layer fixes (e.g. the A/B
# OTA rollback chain) can be reviewed and merged via PR.
meta/*
!meta/meta-zion/
!meta/meta-zion/**
